<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Boot status report, and the persisted heartbeat job across restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- One-off cleanup of saved Wi-Fi networks after provisioning (WifiCleanup).
         Listing saved networks requires location access; the DPC grants itself
         these only for the cleanup. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 11+ package visibility: without this, the DPC cannot resolve
         the HA app's launch intent and the kiosk never starts. -->
    <queries>
        <package android:name="io.homeassistant.companion.android.minimal" />
    </queries>

    <!-- Cleartext allowed: status reports go to the HA instance, which on a
         LAN is commonly plain http:// (see res/xml/network_security_config.xml). -->
    <application
        android:label="HA Panel DPC"
        android:networkSecurityConfig="@xml/network_security_config">

        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Android 12+ QR provisioning: both activities are mandatory or provisioning aborts. -->
        <activity
            android:name=".GetProvisioningModeActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PolicyComplianceActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Legacy (Android 9-11) post-provisioning entry point. -->
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PanelCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dk.yepzdk.hapanel.SCREEN_OFF" />
                <action android:name="dk.yepzdk.hapanel.SCREEN_ON" />
                <action android:name="dk.yepzdk.hapanel.SET_BRIGHTNESS" />
                <action android:name="dk.yepzdk.hapanel.NAVIGATE" />
                <action android:name="dk.yepzdk.hapanel.REBOOT" />
                <action android:name="dk.yepzdk.hapanel.MAINTENANCE_ON" />
                <action android:name="dk.yepzdk.hapanel.MAINTENANCE_OFF" />
                <action android:name="dk.yepzdk.hapanel.UPDATE_HA" />
                <action android:name="dk.yepzdk.hapanel.UPDATE_PANEL" />
                <action android:name="dk.yepzdk.hapanel.FACTORY_RESET" />
                <action android:name="dk.yepzdk.hapanel.LINK" />
                <action android:name="dk.yepzdk.hapanel.UNLINK" />
                <action android:name="dk.yepzdk.hapanel.REPORT" />
            </intent-filter>
        </receiver>

        <!-- Screen-off overlay. Its own pinned task on top of the dashboard;
             finishing it returns to the pinned HA app. -->
        <activity
            android:name=".ScreenOffActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:lockTaskMode="if_whitelisted"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <receiver
            android:name=".PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Heartbeat and boot status reports to the Smart Panel integration. -->
        <service
            android:name=".StatusJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".InstallService$ResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dk.yepzdk.hapanel.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
